# 이 파일을 복사해 .env 를 만든 뒤 값을 채운다.
#
#   cp .env.example .env
#
# .env 는 커밋하지 않는다 (.gitignore 에 등록돼 있음).
# docker-compose 는 .env 를 자동으로 읽고, 애플리케이션은 application-local.yml 의
# spring.config.import 로 읽는다. 별도 라이브러리는 쓰지 않는다.

# --- MySQL ------------------------------------------------------------------
# DB_PORT 는 호스트에 노출할 포트다. 로컬에 MySQL 이 이미 있으면 3306 을 피한다.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=getit
DB_USERNAME=getit
DB_PASSWORD=변경하세요
MYSQL_ROOT_PASSWORD=변경하세요

# --- CORS -------------------------------------------------------------------
# 프론트 오리진. 여러 개면 콤마로 구분한다.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- 인증 --------------------------------------------------------------------
# JWT 서명 키 (HS256 기준 32바이트 이상). 예: openssl rand -base64 48
JWT_SECRET=

# Google Cloud Console 에서 발급한 OAuth 2.0 클라이언트 값.
# 승인된 리디렉션 URI 에 http://localhost:8080/login/oauth2/code/google 을 등록한다.
#
# ⚠️ 주석을 지우고 빈 값으로 두지 말 것. 빈 문자열도 '값' 으로 취급돼
#    Spring Security 가 기동 단계에서 실패한다. 채울 때만 주석을 해제한다.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# 로그인 성공 후 사용자를 돌려보낼 프론트 주소. 기본값은 Vite dev 서버다.
#OAUTH2_REDIRECT_URI=http://localhost:5173/oauth/callback

# --- 파일 업로드 ---------------------------------------------------------------
# 업로드 파일 저장 경로. 기본값 ./uploads 는 .gitignore 에 등록돼 있다.
#FILE_LOCAL_PATH=./uploads
# 업로드 결과 URL 의 앞부분. 배포 환경에서는 실제 도메인으로 바꾼다.
#FILE_BASE_URL=http://localhost:8080/api/public/files

# --- 쿠키 --------------------------------------------------------------------
# Refresh Token 쿠키. 로컬(http)에서는 secure=true 면 브라우저가 쿠키를 저장하지 않는다.
# 배포 환경에서는 반드시 true 로 둔다.
#REFRESH_COOKIE_SECURE=false
# 프론트와 백엔드가 서로 다른 사이트면 Lax 로는 재발급 요청에 쿠키가 실리지 않는다.
#REFRESH_COOKIE_SAME_SITE=Lax

# --- Azure Blob 직접 업로드 (선택) -------------------------------------------
# 끄면(기본) 로컬 디스크에 저장한다. 로컬 개발에서는 켤 필요가 없다.
#FILE_AZURE_ENABLED=false
#
# 켤 때만 아래를 채운다. 계정 키는 쓰지 않는다 — VM 의 관리 ID 로 인증한다.
# 비공개: 제출물 · 강의자료.  공개: 프로필 사진 · 활동사진.
#AZURE_UPLOAD_ACCOUNT=
#AZURE_UPLOAD_CONTAINER=uploads
#AZURE_PUBLIC_ACCOUNT=
#AZURE_PUBLIC_CONTAINER=public-assets
#
# 서명 주소의 유효 시간. 비워 두면 애플리케이션 기본값을 쓴다.
#FILE_UPLOAD_URL_TTL=PT10M
#FILE_DOWNLOAD_URL_TTL=PT5M
#FILE_DELEGATION_KEY_TTL=PT6H
